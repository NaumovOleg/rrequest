{
  "name": "rrequest",
  "displayName": "RREQUEST",
  "description": "A Postman-style REST client for VS Code",
  "version": "0.0.4",
  "publisher": "olgert",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "rrequest.open",
        "title": "RREQUEST: Open"
      },
      {
        "command": "rrequest.signInToSync",
        "title": "RREQUEST: Sign in to sync (Google)"
      },
      {
        "command": "rrequest.enableWorkspaceSync",
        "title": "RREQUEST: Enable sync for active workspace"
      },
      {
        "command": "rrequest.syncNow",
        "title": "RREQUEST: Sync now"
      }
    ],
    "configuration": {
      "title": "RREQUEST",
      "properties": {
        "rrequest.syncServerUrl": {
          "type": "string",
          "default": "",
          "description": "rrequest sync backend URL (ending in /api). Leave empty to use the URL baked into this build (production by default)."
        },
        "rrequest.syncPollIntervalMs": {
          "type": "number",
          "default": 45000,
          "description": "How often (in milliseconds) rrequest polls the sync backend for remote workspace changes"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rrequest",
          "title": "RREQUEST",
          "icon": "resources/rrequest.svg"
        }
      ]
    },
    "views": {
      "rrequest": [
        {
          "id": "rrequest.sidebar",
          "name": "RREQUEST",
          "type": "webview"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NaumovOleg/rrequest"
  },
  "icon": "resources/rrequest.png",
  "homepage": "https://naumovoleg.github.io/rrequest/",
  "scripts": {
    "build": "RM_ENTRY=editor vite build && RM_ENTRY=sidebar vite build && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run",
    "test:server": "vitest run -c vitest.server.config.ts",
    "test:infra": "vitest run --root infra",
    "test:all": "npm run test && npm run test:server && npm run test:infra",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p test/server/tsconfig.json",
    "typecheck:infra": "tsc --noEmit -p infra/tsconfig.json",
    "deploy": "cd infra && cdk deploy --all --require-approval never",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:status": "changeset status"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.665.0",
    "@aws-sdk/lib-dynamodb": "^3.665.0",
    "@changesets/cli": "^2.31.1",
    "@heliosjs/aws": "^10.0.1",
    "@heliosjs/core": "^3.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.2.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.0",
    "aws-cdk": "^2.1133.0",
    "aws-cdk-lib": "^2.161.0",
    "constructs": "^10.3.0",
    "dynalite": "^3.2.2",
    "esbuild": "^0.20.0",
    "google-auth-library": "^9.14.0",
    "jsdom": "^24.0.0",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0",
    "vite": "^5.1.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@vscode/codicons": "^0.0.45",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.16.0",
    "zustand": "^4.5.0"
  }
}
