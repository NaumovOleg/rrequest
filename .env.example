# Single ROOT env file for local dev — copy to `.env` (dev) and/or `.env.prod`.
# Read by:
#   - the extension build (esbuild bakes SYNC_SERVER_URL into the bundle)
#   - a local `cdk deploy` (server/infra/bin/app.ts)
# CI never uses these files — it injects the same names from GitHub Environments,
# which always win. Select a file with ENV_FILE (default .env), e.g.
#   ENV_FILE=.env.prod npx cdk deploy --all

# --- Extension build ---
# Sync backend base URL baked into the build (MUST end in /api). Unset -> prod.
SYNC_SERVER_URL=https://<your-dev-fnurl-id>.lambda-url.eu-west-1.on.aws/api

# --- Local `cdk deploy` (server/infra) ---
STAGE=development                         # development -> DevelopmentRrequestStack; production -> RrequestStack
CDK_DEFAULT_ACCOUNT=389151907894
CDK_DEFAULT_REGION=eu-west-1
GOOGLE_CLIENT_ID=<oauth-client-id>
GOOGLE_REDIRECT_URI=https://<your-fnurl-id>.lambda-url.eu-west-1.on.aws/api/auth/callback

# Secret VALUES baked into the Lambda env at deploy (keep out of git):
GOOGLE_CLIENT_SECRET=<oauth-client-secret>
JWT_SECRET=<long-random-string>           # openssl rand -hex 32 — keep STABLE across deploys
TOKEN_ENC_KEY=<long-random-string>        # openssl rand -hex 32 — rotating invalidates stored refresh tokens
