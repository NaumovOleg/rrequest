# Copy to .env for a local dev build. esbuild bakes SYNC_SERVER_URL into the
# extension as the default sync backend URL (dev/prod per build). Unset -> prod.
# Point at your development stack's Lambda Function URL (must end in /api):
SYNC_SERVER_URL=https://<your-dev-fnurl-id>.lambda-url.eu-west-1.on.aws/api
