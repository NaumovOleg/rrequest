{
  "name": "rrequest",
  "displayName": "RREQUEST",
  "description": "A Postman-style REST client for VS Code",
  "version": "0.0.1",
  "publisher": "olgert",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "rrequest.open",
        "title": "RREQUEST: Open"
      },
      {
        "command": "rrequest.signInToSync",
        "title": "RREQUEST: Sign in to sync (Google)"
      },
      {
        "command": "rrequest.enableWorkspaceSync",
        "title": "RREQUEST: Enable sync for active workspace"
      },
      {
        "command": "rrequest.syncNow",
        "title": "RREQUEST: Sync now"
      }
    ],
    "configuration": {
      "title": "RREQUEST",
      "properties": {
        "rrequest.syncServerUrl": {
          "type": "string",
          "default": "https://slgvpoiwdpzymrlg6iu4zbowea0yneyw.lambda-url.eu-west-1.on.aws/api",
          "description": "rrequest sync backend URL"
        },
        "rrequest.syncPollIntervalMs": {
          "type": "number",
          "default": 45000,
          "description": "How often (in milliseconds) rrequest polls the sync backend for remote workspace changes"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rrequest",
          "title": "RREQUEST",
          "icon": "resources/rrequest.svg"
        }
      ]
    },
    "views": {
      "rrequest": [
        {
          "id": "rrequest.sidebar",
          "name": "RREQUEST",
          "type": "webview"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NaumovOleg/rrequest"
  },
  "icon": "resources/rrequest.png",
  "homepage": "https://naumovoleg.github.io/rrequest/",
  "scripts": {
    "build": "RM_ENTRY=editor vite build && RM_ENTRY=sidebar vite build && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.2.0",
    "@types/node": "^18.19.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild": "^0.20.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.1.0",
    "vitest": "^1.4.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@vscode/codicons": "^0.0.45",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.16.0",
    "zustand": "^4.5.0"
  }
}
